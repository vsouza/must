{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Must board",
  "description": "Formato de importação/exportação do board. Um arquivo por viagem. Versão 2 (prompt 28): a viagem vem em tripId + countryCode (viagens criadas no app, ex. portugal-k3f9); a versão 1, com region (bh, jp, it), continua sendo lida (seeds e exports antigos). Tudo que o app sabe de um lugar cabe aqui; o que vem do Google Places (horários, preço, placeId) é cache e pode ser nulo.",
  "type": "object",
  "required": ["version", "lists", "places"],
  "anyOf": [{"required": ["tripId"]}, {"required": ["region"]}],
  "properties": {
    "version": {"enum": [1, 2, 3]},
    "tripId": {"type": "string", "pattern": "^[a-z0-9-]+$", "description": "id da viagem (bh, jp, it nas de fábrica; <slug>-<4 letras> nas criadas no app). Versão 2."},
    "countryCode": {"type": "string", "pattern": "^[A-Z]{2}$", "description": "país da viagem, ISO 3166-1 alfa-2. Versão 2."},
    "region": {"enum": ["bh", "jp", "it"], "description": "legado (versão 1): a viagem de fábrica do arquivo."},
    "trip": {
      "type": "object",
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"},
        "home": {"type": "string", "description": "bairro/base onde dorme; usado pra 'último metrô pra casa'"},
        "cities": {"type": "array", "items": {"type": "object", "required": ["id", "name"], "properties": {
          "id": {"type": "string"}, "name": {"type": "string"}, "from": {"type": "string", "format": "date"}, "to": {"type": "string", "format": "date"},
          "tz": {"type": "string"}, "currency": {"enum": ["BRL", "JPY", "EUR"]}, "lat": {"type": "number"}, "lng": {"type": "number"}}}}
      }
    },
    "budget": {"type": "object", "properties": {"perDay": {"type": "number"}, "currency": {"enum": ["BRL", "JPY", "EUR"]}, "walkMaxKm": {"type": "number"}, "dayStart": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"}}},
    "lists": {"type": "array", "items": {"type": "object", "required": ["id", "name", "color"], "properties": {
      "id": {"type": "string"}, "name": {"type": "string", "description": "sem o prefixo 'Must'"}, "kanji": {"type": "string", "maxLength": 1},
      "icon": {"type": "string", "description": "nome do arquivo em design/icons sem .svg"},
      "color": {"enum": ["eat", "drink", "coffee", "see", "temple", "listen", "shop", "night", "photo", "art", "sport"]},
      "kind": {"enum": ["place", "photo", "art", "sport", "experience"], "description": "tipo da lista; photo/art/sport/experience têm painel próprio no Lugar (ausente = place)"},
      "photo": {"type": ["object", "null"], "properties": {"flickrId": {"type": "string"}, "url": {"type": "string"}, "credit": {"type": "string"}, "license": {"type": "string"}}},
      "sub": {"type": "array", "items": {"type": "string"}, "description": "sub-listas como Ramen, Sushi"}}}},
    "places": {"type": "array", "items": {"type": "object", "required": ["id", "name", "listId", "cityId"], "properties": {
      "id": {"type": "string"}, "name": {"type": "string"}, "nameLocal": {"type": "string"}, "listId": {"type": "string"}, "sub": {"type": "string"}, "cityId": {"type": "string"},
      "area": {"type": "string", "description": "bairro"}, "lat": {"type": "number"}, "lng": {"type": "number"}, "approx": {"type": "boolean", "description": "coordenada chutada; resolver no Places"},
      "placeId": {"type": ["string", "null"]},
      "price": {"type": ["number", "null"], "description": "gasto esperado por pessoa, na moeda da região"}, "priceLevel": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
      "hours": {"type": ["object", "null"], "description": "cache do Places: weekdayText + periods"},
      "window": {"type": "array", "items": {"enum": ["morning", "lunch", "afternoon", "dinner", "night"]}},
      "reservation": {"type": ["object", "null"], "properties": {"at": {"type": "string", "format": "date-time"}, "party": {"type": "integer"}, "note": {"type": "string"}}},
      "saveForEnd": {"type": "boolean"}, "allowBudgetException": {"type": "boolean"}, "queueMinutes": {"type": ["integer", "null"]},
      "notes": {"type": "string"},
      "order": {"type": "integer", "description": "ordem dentro da lista (Board, arrastar); ausente = 0"},
      "source": {"type": ["object", "null"], "properties": {"kind": {"enum": ["instagram", "tiktok", "youtube", "maps", "manual", "board"]}, "url": {"type": "string"}, "savedAt": {"type": "string", "format": "date"}, "caption": {"type": "string"}, "author": {"type": "string"}}},
      "done": {"type": ["object", "null"], "properties": {"at": {"type": "string", "format": "date-time"}, "spent": {"type": "number"}}},
      "tickets": {"type": "array", "description": "ingressos anexados: âncoras do dia (como reserva). O PDF não vai no arquivo.", "items": {"type": "object", "required": ["id", "at"], "properties": {
        "id": {"type": "string"}, "at": {"type": "string", "format": "date-time"}, "sessionId": {"type": "string", "description": "id da sessão ligada (EventSession)"},
        "confirmation": {"type": "string"}, "qrPayload": {"type": "string"}, "pdfName": {"type": "string", "description": "nome do arquivo no aparelho; não é exportado como arquivo"},
        "paid": {"type": "number"}, "people": {"type": "integer"}, "cancelUntil": {"type": "string", "format": "date-time"}, "walletPassURL": {"type": "string", "format": "uri"}}}},
      "extra": {"type": ["object", "null"], "description": "dados do tipo da lista (photo, art, sport ou experience)", "properties": {
        "experience": {"type": "object", "description": "experiência com hora marcada; sessions usam o mesmo formato de art/sport", "properties": {
          "supplier": {"enum": ["viator", "getYourGuide", "klook", "airbnb", "other"]}, "productCode": {"type": "string"}, "url": {"type": "string", "format": "uri"},
          "durationMinutes": {"type": "integer"}, "priceFrom": {"type": "number"}, "currency": {"enum": ["BRL", "JPY", "EUR", "USD"]}, "rating": {"type": "number"}, "reviewCount": {"type": "integer"},
          "meetingPoint": {"type": "string"}, "meetingLat": {"type": "number"}, "meetingLng": {"type": "number"}, "languages": {"type": "array", "items": {"type": "string"}},
          "groupMax": {"type": "integer"}, "freeCancellationHours": {"type": "integer"},
          "sessions": {"type": "array", "items": {"type": "object", "required": ["at", "title"], "properties": {"at": {"type": "string", "format": "date-time"}, "title": {"type": "string"}, "price": {"type": "number"}, "soldOut": {"type": "boolean"}, "url": {"type": "string", "format": "uri"}, "bought": {"type": "boolean"}, "note": {"type": "string"}}}}}},
        "photo": {"type": "object", "properties": {"facing": {"type": "number", "minimum": 0, "maximum": 360, "description": "azimute do eixo/vista, graus"}, "bestLight": {"type": "array", "items": {"enum": ["golden-am", "golden-pm", "blue", "hard", "night"]}}, "gear": {"type": "string"}, "tripodAllowed": {"type": "boolean"}, "crowdNote": {"type": "string"}}},
        "art": {"type": "object", "properties": {"style": {"type": "array", "items": {"type": "string"}}, "priceAdult": {"type": "number"}, "priceStudent": {"type": "number"}, "freeNote": {"type": "string"}, "runsFrom": {"type": "string", "format": "date"}, "runsUntil": {"type": "string", "format": "date"}, "lastEntryMinutes": {"type": "integer", "description": "última entrada: minutos antes de fechar"}, "needsBooking": {"type": "boolean"}, "ticketURL": {"type": "string", "format": "uri"}, "durationMinutes": {"type": "integer"}, "photographyAllowed": {"type": "boolean"}, "floors": {"type": "integer"}, "note": {"type": "string"},
          "sessions": {"type": "array", "items": {"type": "object", "required": ["at", "title"], "properties": {"at": {"type": "string", "format": "date-time"}, "title": {"type": "string"}, "price": {"type": "number"}, "soldOut": {"type": "boolean"}, "url": {"type": "string", "format": "uri"}, "bought": {"type": "boolean", "description": "ingresso comprado: vira âncora do dia"}, "note": {"type": "string"}}}}}},
        "program": {"type": "array", "description": "programação colada (link, texto ou foto do cartaz) de casa de show, estádio ou museu; aparece em Em cartaz", "items": {"type": "object", "required": ["at", "title"], "properties": {"at": {"type": "string", "format": "date-time"}, "title": {"type": "string"}, "price": {"type": "number"}, "soldOut": {"type": "boolean"}, "url": {"type": "string", "format": "uri"}, "bought": {"type": "boolean"}, "note": {"type": "string"}}}},
        "programSource": {"enum": ["link", "poster"], "description": "de onde veio program"}, "programCheckedAt": {"type": "string", "format": "date-time", "description": "quando a programação foi colada"},
        "sport": {"type": "object", "properties": {"activity": {"enum": ["run", "bike", "hike", "swim", "climb", "walk", "watch"]}, "distanceKm": {"type": "number"}, "elevationM": {"type": "integer"}, "surface": {"type": "string"}, "loop": {"type": "boolean"}, "routeNote": {"type": "string"}, "facilities": {"type": "array", "items": {"type": "string"}}, "preferredTempMax": {"type": "integer", "default": 28}, "preferredUVMax": {"type": "integer", "default": 6},
          "sessions": {"type": "array", "items": {"type": "object", "required": ["at", "title"], "properties": {"at": {"type": "string", "format": "date-time"}, "title": {"type": "string"}, "price": {"type": "number"}, "soldOut": {"type": "boolean"}, "url": {"type": "string", "format": "uri"}, "bought": {"type": "boolean", "description": "ingresso comprado: vira âncora do dia"}, "note": {"type": "string"}}}}}}}}}}},
    "expenses": {"type": "array", "items": {"type": "object", "required": ["at", "amount"], "properties": {"at": {"type": "string", "format": "date-time"}, "amount": {"type": "number"}, "category": {"enum": ["food", "coffee", "transit", "shop", "ticket", "other"]}, "placeId": {"type": ["string", "null"]}, "method": {"enum": ["cash", "card", "transit-card"]}}}},
    "events": {"type": "array", "description": "eventos sem lugar (trem, dia inteiro, outro). kind flight é lido como reserva de voo (flights), por compatibilidade", "items": {"type": "object", "required": ["at", "title"], "properties": {"at": {"type": "string", "format": "date-time"}, "title": {"type": "string"}, "kind": {"enum": ["train", "flight", "dayTrip", "event", "other"]}, "note": {"type": "string"}, "allDay": {"type": "boolean"}, "weatherDependent": {"type": "boolean"}}}},
    "flights": {"type": "array", "description": "reservas de voo (PNR): pernas, franquia e checklist. Sem o checklist, o app usa o modelo do trecho (intl-japan ou domestic-br)", "items": {"type": "object", "required": ["legs"], "properties": {
      "pnr": {"type": "string"}, "carrier": {"type": "string"}, "template": {"enum": ["intl-japan", "domestic-br"]}, "checkedKg": {"type": "integer"}, "cabinKg": {"type": "integer"},
      "legs": {"type": "array", "items": {"type": "object", "required": ["number", "from", "to", "departs"], "properties": {"number": {"type": "string"}, "from": {"type": "string", "description": "IATA"}, "to": {"type": "string", "description": "IATA"}, "departs": {"type": "string", "format": "date-time"}, "arrives": {"type": "string", "format": "date-time"}, "seat": {"type": "string"}, "terminal": {"type": "string"}, "gate": {"type": "string"}, "note": {"type": "string"}}}},
      "checklist": {"type": "array", "items": {"type": "object", "required": ["id", "phase", "title", "done"], "properties": {"id": {"type": "string"}, "phase": {"enum": ["h72", "bags", "airport", "arrival"]}, "title": {"type": "string"}, "note": {"type": "string"}, "done": {"type": "boolean"}, "dueAt": {"type": "string", "format": "date-time"}, "auto": {"type": "boolean"}, "autoRule": {"type": "string"}}}}}}},
    "gifts": {"type": "array", "description": "lista de presentes (versão 3): o que comprar, pra quem, onde. Arquivo sem gifts continua válido", "items": {"type": "object", "required": ["id", "title"], "properties": {
      "id": {"type": "string"}, "title": {"type": "string"}, "person": {"type": "string"}, "quantity": {"type": "integer", "minimum": 1},
      "estimatedPrice": {"type": "number", "description": "uma unidade, na moeda da viagem"}, "paidPrice": {"type": "number", "description": "total pago"}, "boughtAt": {"type": "string", "format": "date-time"},
      "source": {"enum": ["name", "link", "video", "place", "photo"]}, "sourceURL": {"type": "string"}, "sourceLabel": {"type": "string"}, "videoClip": {"type": "string"},
      "placeId": {"type": "string", "description": "loja do board"}, "storeName": {"type": "string"}, "storeLat": {"type": "number"}, "storeLng": {"type": "number"}, "chain": {"type": "boolean"},
      "note": {"type": "string"}, "order": {"type": "integer"}}}},
    "days": {"type": "array", "description": "dias já montados/aceitos", "items": {"type": "object", "properties": {"date": {"type": "string", "format": "date"}, "kind": {"enum": ["free", "shopping", "night", "photo", "temples", "rest"]}, "budget": {"type": "number"}, "walk": {"enum": ["low", "normal", "high"]}, "stops": {"type": "array", "items": {"type": "object", "properties": {"placeId": {"type": "string"}, "at": {"type": "string"}, "done": {"type": "boolean"}}}}}}}
  }
}

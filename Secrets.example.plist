<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copie para Secrets.plist (na raiz, ao lado deste arquivo) e preencha. Secrets.plist é gitignored. -->
<plist version="1.0">
<dict>
	<key>GOOGLE_PLACES_KEY</key>
	<string></string>
	<key>ANTHROPIC_KEY</key>
	<string></string>
	<!-- Mapas offline por cidade: URL pública do bucket R2 (scripts/tiles-upload.sh), ex. https://pub-xxxx.r2.dev -->
	<key>MAP_TILES_URL</key>
	<string></string>
	<!-- Opcional: tiles hospedados pela Protomaps quando não há MAP_TILES_URL -->
	<key>PROTOMAPS_KEY</key>
	<string></string>
	<!-- Opcional: dicas de quem foi (Lugar › Dicas) -->
	<key>FOURSQUARE_KEY</key>
	<string></string>
	<key>REDDIT_CLIENT_ID</key>
	<string></string>
	<!-- Opcional: status de voo ao vivo (prompt 15). AeroDataBox via RapidAPI: é a X-RapidAPI-Key -->
	<key>AERODATABOX_KEY</key>
	<string></string>
</dict>
</plist>
